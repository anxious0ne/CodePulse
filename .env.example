# Security
SECRET_KEY=django-insecure-codepulse-dev-secret-key-change-in-prod-12345
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (Optional: defaults to SQLite if DB_ENGINE != mysql or DB_NAME is missing)
DB_ENGINE=sqlite
DB_NAME=codepulse_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Codeforces API Credentials (from https://codeforces.com/settings/api)
CODEFORCES_API_KEY=your_codeforces_api_key_here
CODEFORCES_API_SECRET=your_codeforces_api_secret_here
